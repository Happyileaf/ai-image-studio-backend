<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- =========================
         Spring Boot 4.1.x 父 POM
         注意：Spring Boot 4 基于 Spring Framework 7 + Jakarta EE 11
         ========================= -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.styletransfer</groupId>
    <artifactId>studio</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>AI Image Style Transfer Studio - Backend</name>
    <description>AI 图片风格迁移工作台后端服务</description>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>

        <!-- ====== 关键依赖版本锁定（严格对齐《技术栈文档》5.1 节约束） ====== -->
        <!-- MyBatis-Plus 3.5.17：必须使用 boot4-starter，3.5.16 修复 Boot4 factoryBeanObjectType Bug -->
        <mybatis-plus.version>3.5.17</mybatis-plus.version>

        <!-- Redisson 4.7.0+：修复 Spring Data Redis 4.1 导致的 StackOverflow Bug -->
        <redisson.version>4.7.0</redisson.version>

        <!-- SpringDoc 3.1.0+：对齐 Spring Boot 4.1.0（2026-07-31 发布） -->
        <springdoc.version>3.1.0</springdoc.version>

        <!-- MinIO SDK 8.6.0：官方最新稳定，独立 XML/HTTP 解析器，不依赖 Jackson -->
        <minio.version>8.6.0</minio.version>

        <!-- jjwt 0.12.6+：必须用 jjwt-gson 规避 Jackson 3 冲突 -->
        <jjwt.version>0.12.6</jjwt.version>

        <!-- Hutool 5.8.x：通用工具集，不依赖 Jackson 3，安全 -->
        <hutool.version>5.8.38</hutool.version>

        <!-- MapStruct 1.6.3：CI 已验证 Java 25/26，1.7.0.Beta2 可选 -->
        <mapstruct.version>1.6.3</mapstruct.version>

        <!-- Lombok 1.18.46：Java 26 最低 1.18.46；Java 25 最低 1.18.40 -->
        <lombok.version>1.18.46</lombok.version>

        <!-- Apache Commons Compress 1.27.x：ZIP 打包（批量下载） -->
        <commons-compress.version>1.27.1</commons-compress.version>

        <!-- Apache Tika：MIME 类型真实校验 -->
        <tika.version>3.1.0</tika.version>

        <!-- MySQL Connector J 9.x：MySQL 8.4 LTS 驱动 -->
        <mysql-connector.version>9.2.0</mysql-connector.version>

        <!-- Testcontainers 2.x（Spring Boot 4 强制；BOM 统一管理各模块版本） -->
        <testcontainers.version>2.0.1</testcontainers.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Testcontainers BOM：统一管理 testcontainers-mysql/redis/rabbitmq/minio 版本 -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- =========================
             核心起步（Spring Boot 4.x 模块化，注意重命名）
             ========================= -->
        <!-- Web：取代 spring-boot-starter-web（Spring Boot 4 模块化） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- 参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 安全框架：Spring Security 7.x -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- AOP：取代 spring-boot-starter-aop（限流 @RateLimit 切面需要） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>

        <!-- WebFlux：仅用作 WebClient 响应式 HTTP 客户端（调用 AI API + Resend），不启动服务器 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- =========================
             数据访问层
             ========================= -->
        <!-- MyBatis-Plus 3.5.17：Spring Boot 4 专用 starter（严禁使用 boot3-starter） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <!-- MyBatis-Plus 3.5.6+ 将 JSqlParser 拆分为独立模块，分页插件依赖它 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- MySQL 驱动 9.x -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql-connector.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway 数据库迁移：Boot 4 模块化 starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <!-- Flyway MySQL 模块：Flyway 8.x 起需显式引入，否则报错 "Unsupported Database: MySQL 8.x" -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- =========================
             缓存 + 消息队列
             ========================= -->
        <!-- Redis + Spring Data Redis 4.1 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Redisson 4.7.0：分布式锁 + Redis 客户端（单用户并发控制、额度扣减锁） -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
            <version>${redisson.version}</version>
        </dependency>

        <!-- RabbitMQ 消息队列（异步任务队列） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- =========================
             对象存储：MinIO SDK 8.6.0
             独立坐标，不被 Spring Boot BOM 管理
             ========================= -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>${minio.version}</version>
        </dependency>
        <!-- OkHttp：MinIO SDK 8.6.0 的 HTTP 客户端依赖（传递依赖可能被 BOM 降级，显式声明） -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>4.12.0</version>
        </dependency>

        <!-- =========================
             ⚠️ JWT：jjwt-gson 方案（推荐，规避 Jackson 3 冲突）
             jjwt-jackson 是 Jackson 2 实现 → 与 Boot 4 默认 Jackson 3 不兼容
             jjwt-gson 内部仅依赖 Gson，不碰 Jackson classpath
             ========================= -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-gson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- =========================
             工具库
             ========================= -->
        <!-- Lombok：仅编译期，运行时不打 jar -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Hutool 通用工具集（Java 17+ 基线，无 Jackson 3 直接依赖，安全） -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>${hutool.version}</version>
        </dependency>

        <!-- MapStruct API：DTO ↔ Entity 自动映射（处理器在 maven-compiler-plugin annotationProcessorPaths） -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>

        <!-- Apache Commons Compress：ZIP 打包（批量下载历史图片） -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
            <version>${commons-compress.version}</version>
        </dependency>

        <!-- Apache Tika：真实 MIME 类型识别（防伪装文件上传） -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
            <version>${tika.version}</version>
        </dependency>

        <!-- Jackson 3：Spring Boot 4 默认 Jackson 3（tools.jackson）
             注解仍用 com.fasterxml.jackson.annotation（jackson-annotations 2.20） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jackson</artifactId>
        </dependency>

        <!-- =========================
             API 文档：SpringDoc 3.1.0（Swagger UI）
             Spring Boot 4.x 必须使用 3.x 分支（2.x 仅支持 Boot 3）
             ========================= -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- =========================
             监控：Spring Boot Actuator
             ========================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- =========================
             测试（Spring Boot 4 模块化）
             ========================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test-classic</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers 2.x：注意 artifact rename（testcontainers-mysql 而非 mysql）
             容器类包名：org.testcontainers.mysql.MySQLContainer 等 -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-mysql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-rabbitmq</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-minio</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Redis 测试容器：TC 2.x 中 Redis 模块为社区维护，不在官方 BOM 中。
             集成测试时可用 GenericContainer + redis:8.10-alpine 镜像替代，
             或引入 com.redis:testcontainers-redis 社区坐标。-->
    </dependencies>

    <build>
        <plugins>
            <!-- =========================
                 ⚠️ 关键：Maven Compiler 插件（JDK 23+ 注解处理必须显式声明）
                 不配置则 Lombok / MapStruct 全部不生效（cannot find symbol）
                 ========================= -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!-- 目标 Java 25 LTS；如需尝鲜 Java 26 改为 26 -->
                    <release>25</release>
                    <!-- ⚠️ JDK 23+ 必填：强制开启注解处理器（默认 -proc:none） -->
                    <proc>full</proc>
                    <annotationProcessorPaths>
                        <!-- 顺序敏感：Lombok → lombok-mapstruct-binding → MapStruct -->
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>0.2.0</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Spring Boot 打包插件 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
